AUTH_MODE=accounts
HOST=127.0.0.1
PORT=4318
# To use on a phone on the same network, set HOST=0.0.0.0 and configure trusted HTTPS.
# API_TOKEN is generated and saved in data/server.json if omitted.
DATA_DIR=./.cache/development-data
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3.5:9b
OLLAMA_VISION_MODEL=qwen3.5:9b
# Optional HTTPS certificate and key paths (relative to the project root or absolute).
TLS_CERT=
TLS_KEY=
# Additional exact browser origins, comma separated. The same-origin PWA is allowed automatically.
ALLOWED_ORIGINS=

# Per-account server picture allowance. Phone cache has its own 500 MB default.
PHOTO_QUOTA_MB=2048
