    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
