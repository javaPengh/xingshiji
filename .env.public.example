AUTH_MODE=accounts
HOST=127.0.0.1
PORT=4318
# Choose your own data directory; the server creates it on first start.
# Relative paths resolve from the source or extracted runtime root.
# For production, prefer an absolute path outside the code/runtime directory.
DATA_DIR=./data
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3.5:9b
OLLAMA_VISION_MODEL=qwen3.5:9b
MAX_USERS=100
DAILY_AI_LIMIT=50
# Set the exact Funnel HTTPS origin if your reverse proxy rewrites Host.
PUBLIC_ORIGIN=

# Per-account server picture allowance. Phone cache has its own 500 MB default.
PHOTO_QUOTA_MB=2048
