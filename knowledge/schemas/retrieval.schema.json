{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "maximumCards": {
      "type": "number",
      "const": 5
    },
    "topics": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidenceTopics": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "generalBackgroundIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "contextOnlyTopicEvidence": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "restrictedQuestionTerms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "candidatePriority": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scopeStatement": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "version",
    "maximumCards",
    "topics",
    "evidenceTopics",
    "generalBackgroundIds",
    "contextOnlyTopicEvidence",
    "restrictedQuestionTerms",
    "candidatePriority",
    "scopeStatement"
  ],
  "additionalProperties": false,
  "$comment": "Also run scripts/validate-nutrition-knowledge.mjs for source hashes, units, conditions and activation constraints; JSON Schema alone cannot verify scientific applicability."
}
