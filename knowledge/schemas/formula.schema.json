{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "methodId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "sourceId": {
      "type": "string",
      "minLength": 1
    },
    "sourceVersion": {
      "type": "string",
      "minLength": 1
    },
    "locator": {
      "type": "object",
      "properties": {
        "artifactPath": {
          "type": "string",
          "minLength": 1
        },
        "artifactSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "paragraph",
            "pdf_page",
            "image_table"
          ]
        },
        "blockIndex": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "page": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "tableNumber": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "row": {
          "type": [
            "string",
            "null"
          ]
        },
        "column": {
          "type": [
            "string",
            "null"
          ]
        },
        "textSha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "verificationTokens": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "artifactPath",
        "artifactSha256",
        "kind",
        "blockIndex",
        "page",
        "tableNumber",
        "row",
        "column",
        "textSha256",
        "verificationTokens"
      ],
      "additionalProperties": false
    },
    "minimumAgeYears": {
      "type": "number",
      "const": 19
    },
    "maximumAgeYearsInclusive": {
      "type": "null"
    },
    "sex": {
      "type": "string",
      "enum": [
        "male",
        "female"
      ]
    },
    "activityCategory": {
      "type": "string",
      "enum": [
        "inactive",
        "low_active",
        "active",
        "very_active"
      ]
    },
    "coefficients": {
      "type": "object",
      "properties": {
        "intercept": {
          "type": "number"
        },
        "ageYears": {
          "type": "number"
        },
        "heightCm": {
          "type": "number"
        },
        "weightKg": {
          "type": "number"
        }
      },
      "required": [
        "intercept",
        "ageYears",
        "heightCm",
        "weightKg"
      ],
      "additionalProperties": false
    },
    "inputUnits": {
      "type": "object",
      "properties": {
        "ageYears": {
          "type": "string",
          "const": "year"
        },
        "heightCm": {
          "type": "string",
          "const": "cm"
        },
        "weightKg": {
          "type": "string",
          "const": "kg"
        }
      },
      "required": [
        "ageYears",
        "heightCm",
        "weightKg"
      ],
      "additionalProperties": false
    },
    "weightBasis": {
      "type": "string",
      "const": "actual"
    },
    "unit": {
      "type": "string",
      "const": "kcal/day"
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "policyIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reviewStatus": {
      "type": "string",
      "enum": [
        "verified_against_original",
        "pending",
        "blocked"
      ]
    },
    "reviewedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "reviewedBy": {
      "type": "string",
      "minLength": 1
    },
    "reviewMethod": {
      "type": "string",
      "minLength": 1
    },
    "professionalReviewPerformed": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "methodId",
    "version",
    "sourceId",
    "sourceVersion",
    "locator",
    "minimumAgeYears",
    "maximumAgeYearsInclusive",
    "sex",
    "activityCategory",
    "coefficients",
    "inputUnits",
    "weightBasis",
    "unit",
    "evidenceIds",
    "policyIds",
    "reviewStatus",
    "reviewedAt",
    "reviewedBy",
    "reviewMethod",
    "professionalReviewPerformed"
  ],
  "additionalProperties": false,
  "$comment": "Also run scripts/validate-nutrition-knowledge.mjs for source hashes, units, conditions and activation constraints; JSON Schema alone cannot verify scientific applicability."
}
